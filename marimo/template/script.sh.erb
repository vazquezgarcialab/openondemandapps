#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

cd "${HOME}"
export PYTHONNOUSERSITE=1

# Expand paths (handle leading ~)
MARIMO_BIN="<%= context.marimo_binary %>"
MARIMO_BIN="${MARIMO_BIN/#\~/$HOME}"
NB="<%= context.notebook_path %>"
NB="${NB/#\~/$HOME}"

# Report the SLURM GPU allocation into the job log (empty on the CPU partitions).
# The NVIDIA driver is installed on the node itself, so CUDA-enabled frameworks in
# your module / conda env pick the card up with no extra setup — pair the gpu-l40s
# partition with e.g. `module load CUDA/12.9.0` or a CUDA build of PyTorch.
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
  echo "GPU allocation: CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
  nvidia-smi -L || true
fi

echo "TIMING - Starting marimo at: $(date)"

# marimo serves under the OnDemand /node reverse proxy: --base-url sets the path
# prefix, --proxy sets the external host so generated links are correct, and
# --token-password gates access. Bind all interfaces so the proxy can reach us.
set -x
exec "${MARIMO_BIN}" edit \
  --headless \
  --host 0.0.0.0 \
  --port "${port}" \
  --base-url "/node/${host}/${port}" \
  --proxy "openondemand.research.mgb.org:443" \
  --token-password "${password}" \
  ${NB:+"${NB}"}
