# Job submission configuration file
#
<%-
  cores = num_cores.to_i
  mem   = memory.to_i
  hours = num_hours.to_i
  # GPUs live only on the gpu-* partitions, and those are reserved for GPU jobs
  # (partition QOS `gpu_required`) — so force at least one GPU there and none
  # elsewhere, whichever way the form's dynamic JS left the field.
  gpus  = queue.to_s.start_with?("gpu") ? [num_gpus.to_i, 1].max : 0
  # gpu-l40s caps wall time at 8 h; clamp so the job is accepted rather than
  # rejected at submit. Raise this if MGB raises the partition's MaxTime.
  hours = [hours, 8].min if gpus > 0
-%>
---
#
# Configure the content of the job script for the batch job here
# @see http://www.rubydoc.info/gems/ood_core/OodCore/BatchConnect/Template
#
batch_connect:
  template: "basic"
  conn_params:
     - csrf_token

script:
  queue_name: "<%= queue %>"
  native: # ... array of command line arguments ...
     - "--partition"
     - "<%= queue %>"
     - "--nodes"
     - 1
     - "--ntasks"
     - "<%= cores %>"
     - "--mem"
     - "<%= mem %>G"
     - "--time"
     - "<%= hours %>:00:00"
     <%- if gpus > 0 -%>
     - "--gpus"
     - "<%= gpus %>"
     <%- end -%>
