<%
  # Shared lab RStudio images (group-readable under /data/vazquez); R libraries are
  # per-user and writable, created on first launch.
  home = ENV['HOME']
  img_dir = "/data/vazquez/ondemand/images/rstudio"
  rlib_dir = "#{home}/R/rstudio-apptainer"
%>
# Batch Connect app configuration file
#
# @note Used to define the submitted cluster, title, description, and
#   hard-coded/user-defined attributes that make up this Batch Connect app.
---

# **MUST** set cluster id here that matches cluster configuration file located
# under /etc/ood/config/clusters.d/*.yml
# NOTE: must match the cluster id in ERIS Nucleus's /etc/ood/config/clusters.d/*.yml
cluster: "nucleus"

# Define attribute values that aren't meant to be modified by the user within
# the Dashboard form
attributes:
  # Modules to load inside the batch job (e.g. "R/4.5"). Left blank because R
  # is provided by the Apptainer image below.
  modules: ""

  extra_rstudio_args: ""

  queue:
    widget: "select"
    label: "Partition"
    help: "ERIS Nucleus SLURM partition. Wall-time limits differ per partition. Pick `gpu-l40s` for an NVIDIA L40S GPU (48 GB, 2 per node, 8 h max) — that partition is reserved for GPU jobs, so at least one GPU is always requested there."
    options:
      - [ "normal (1 day, default)",   "normal",      data-max-num-hours: 24,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "bigmem (2 days, ~1TB RAM)", "bigmem",      data-max-num-hours: 48,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "long (7 days)",             "long",        data-max-num-hours: 168, data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "short (3 hours)",           "short",       data-max-num-hours: 3,   data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "interactive (12 hours)",    "interactive", data-max-num-hours: 12,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "gpu-l40s (8 hours, NVIDIA L40S)", "gpu-l40s", data-max-num-hours: 8, data-set-num-hours: 8, data-max-num-cores: 128, data-min-num-gpus: 1, data-max-num-gpus: 2, data-set-num-gpus: 1 ]
  num_cores:
    widget: "number_field"
    label: "Number of cores"
    value: 4
    max: 96
    help: "Max cores per node: 96 on the CPU partitions, 128 on `gpu-l40s`. Check `sinfo` for the rest."
    min: 1
    step: 1
  num_gpus:
    widget: "number_field"
    label: "Number of GPUs"
    value: 0
    min: 0
    max: 2
    step: 1
    help: "NVIDIA L40S GPUs (48 GB each). Only the `gpu-l40s` partition has GPUs (2 per node); it is reserved for GPU jobs, so selecting it requests at least one. Ignored (forced to 0) on every CPU partition."
  num_hours:
    widget: "number_field"
    label: "Number of hours"
    value: 12
    max: 168
    min: 1
    step: 1
    help: "Wall time in hours (must fit the chosen partition's limit)."
  memory:
    widget: "number_field"
    label: "Memory (GB)"
    value: 16
    max: 1000
    min: 8
    step: 1
  rstudio_image:
    widget: "select"
    label: RStudio image version
    help: "Apptainer/Singularity RStudio image. Add more versions here once their .sif is staged."
    options:
      - [ "4.4.1", "<%= img_dir %>/rstudio-4.4.1.sif", data-set-r-packages: "<%= rlib_dir %>/4.4" ]
  r_packages:
    widget: "select"
    label: R packages library
    help: "Per-version R library (auto-selected from the image version; created on first launch)."
    options:
      - [ "4.4", "<%= rlib_dir %>/4.4" ]

form:
  - modules
  - queue
  - num_cores
  - num_gpus
  - num_hours
  - memory
  - rstudio_image
  - r_packages
  - bc_email_on_started
