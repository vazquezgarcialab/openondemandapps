#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory
cd "${HOME}"
<%- unless context.notebook_directory.blank? -%>
cd "<%= context.notebook_directory %>"
<%- end -%>

# Don't let a user's ~/.local site-packages shadow the environment's packages
export PYTHONNOUSERSITE=1

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts, then load the requested modules
module purge
module load <%= context.modules %>
module list
<%- end -%>

<%- unless context.envscript.blank? -%>
# Optional user environment script (e.g. activate a venv / spack / source setup)
source "<%= context.envscript %>"
<%- end -%>

# Launcher (module/PATH binary, or a named conda env)
LAUNCH=(<%- if context.conda_env.empty? -%><%= context.jupyter_binary %><%- else -%>conda run -n <%= context.conda_env %> <%= context.jupyter_binary %><%- end -%>)

# Enable multi-env kernel discovery only if nb_conda_kernels is importable
# (safe no-op otherwise — avoids crashing the server if the package is absent).
if <%- if context.conda_env.empty? -%>python<%- else -%>conda run -n <%= context.conda_env %> python<%- end -%> -c "import nb_conda_kernels" 2>/dev/null; then
  echo "c.ServerApp.kernel_spec_manager_class = 'nb_conda_kernels.CondaKernelSpecManager'" >> "${CONFIG_FILE}"
fi

# Report the SLURM GPU allocation into the job log (empty on the CPU partitions).
# The NVIDIA driver is installed on the node itself, so CUDA-enabled frameworks in
# your module / conda env pick the card up with no extra setup — pair the gpu-l40s
# partition with e.g. `module load CUDA/12.9.0` or a CUDA build of PyTorch.
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then
  echo "GPU allocation: CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
  nvidia-smi -L || true
fi

# Benchmark info
echo "TIMING - Starting jupyter at: $(date)"

# Launch JupyterLab
set -x
"${LAUNCH[@]}" --config="${CONFIG_FILE}" <%= context.extra_jupyter_args %>
