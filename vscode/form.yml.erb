---
# NOTE: must match the cluster id in ERIS Nucleus's /etc/ood/config/clusters.d/*.yml
cluster: "nucleus"

attributes:
  modules:
    label: "Modules"
    widget: "text_field"
    value: ""
    help: "Space-separated list of modules to load (e.g. 'python/3.11'). Leave blank for none."

  queue:
    widget: "select"
    label: "Partition"
    help: "ERIS Nucleus SLURM partition. Wall-time limits differ per partition. Pick `gpu-l40s` for an NVIDIA L40S GPU (48 GB, 2 per node, 8 h max) — that partition is reserved for GPU jobs, so at least one GPU is always requested there."
    options:
      - [ "normal (1 day, default)",   "normal",      data-max-num-hours: 24,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "bigmem (2 days, ~1TB RAM)", "bigmem",      data-max-num-hours: 48,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "long (7 days)",             "long",        data-max-num-hours: 168, data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "short (3 hours)",           "short",       data-max-num-hours: 3,   data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "interactive (12 hours)",    "interactive", data-max-num-hours: 12,  data-max-num-cores: 96,  data-set-num-gpus: 0, data-hide-num-gpus: true ]
      - [ "gpu-l40s (8 hours, NVIDIA L40S)", "gpu-l40s", data-max-num-hours: 8, data-set-num-hours: 8, data-max-num-cores: 128, data-min-num-gpus: 1, data-max-num-gpus: 2, data-set-num-gpus: 1 ]

  num_cores:
    widget: "number_field"
    label: "Number of cores"
    value: 1
    max: 96
    help: "Max cores per node: 96 on the CPU partitions, 128 on `gpu-l40s`. Check `sinfo` for the rest."
    min: 1
    step: 1
  num_gpus:
    widget: "number_field"
    label: "Number of GPUs"
    value: 0
    min: 0
    max: 2
    step: 1
    help: "NVIDIA L40S GPUs (48 GB each). Only the `gpu-l40s` partition has GPUs (2 per node); it is reserved for GPU jobs, so selecting it requests at least one. Ignored (forced to 0) on every CPU partition."


  memory:
    widget: "number_field"
    label: "Memory (GB)"
    value: 8
    max: 1000
    min: 1
    step: 1
    help: "Requested memory in GB"

  num_hours:
    widget: "number_field"
    label: "Number of hours"
    value: 12
    max: 168
    min: 1
    step: 1
    help: "Wall time in hours (must fit the chosen partition's limit)."

  excluded_nodes:
    widget: "text_field"
    label: "Excluded Nodes"
    help: "Comma-separated list of nodes to exclude (e.g. node01,node02). Leave blank if none."

  vscode_binary:
    label: VS Code Binary
    help: "Path to the VS Code CLI (e.g. ~/.local/bin/code). Install with the standalone CLI from https://update.code.visualstudio.com/latest/cli-linux-x64/stable."
    value: '~/.local/bin/code'

form:
  - modules
  - queue
  - num_cores
  - num_gpus
  - num_hours
  - memory
  - excluded_nodes
  - vscode_binary
  - bc_email_on_started
