#!/usr/bin/env bash

# This script runs *inside* the Blender container, within the TurboVNC session.

# Drop $HOME entries from PATH so a user's conda/.local binaries (dbus-launch,
# python, ...) can't hijack the XFCE session.
export PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -v "^${HOME}" | paste -sd: -)"

# Set working directory to home directory
cd "${HOME}"

# Blender's GHOST layer probes Wayland and errors without a runtime dir; give it a
# node-local one so it cleanly uses the X11 (Xvnc) backend.
export XDG_RUNTIME_DIR="$(mktemp -d)"

#
# Launch a minimal Xfce window manager (no panel).
#
# This is a single-application session: the user works full-screen in Blender, so
# a taskbar/applications menu adds nothing. We deliberately do NOT start
# xfce4-panel — on this Ubuntu image gdk-pixbuf can't decode PNG (the modular
# png loader is absent and the built-in one isn't registering), so the panel
# fatally aborts trying to load its fallback icon ("Unrecognized image file
# format" loading image-missing.png). xfwm4 only emits non-fatal warnings, so we
# keep it for window management (move/resize/maximize) plus a solid background.
(
  export SEND_256_COLORS_TO_REMOTE=1
  export XDG_CONFIG_HOME="<%= session.staged_root.join("config") %>"
  export XDG_DATA_HOME="<%= session.staged_root.join("share") %>"
  export XDG_CACHE_HOME="$(mktemp -d)"
  set -x
  eval $(dbus-launch --sh-syntax 2>/dev/null)
  xfwm4 --compositor=off --sm-client-disable &
  xsetroot -solid "#D3D3D3"
) &

#
# Start Blender
#
set -x
# GPU node -> hardware-accelerated OpenGL through VirtualGL. The compute nodes are
# headless (no X server bound to the GPU), so VirtualGL's default GLX back end has
# nothing to attach to — use its EGL back end (`-d egl`), which renders straight to
# the NVIDIA device and reads back into the Xvnc session. Verified on gpu-l40s:
# "OpenGL renderer string: NVIDIA L40S/PCIe/SSE2", OpenGL 4.6.
# CPU node (or a GPU we can't render on) -> Mesa software GL (llvmpipe).
VGLRUN=/opt/VirtualGL/bin/vglrun
if [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && [ -x "${VGLRUN}" ] \
   && "${VGLRUN}" -d egl /opt/VirtualGL/bin/glxinfo -B >/dev/null 2>&1; then
  echo "GPU detected -- rendering Blender through VirtualGL (EGL back end)"
  "${VGLRUN}" -d egl blender
else
  echo "No usable GPU -- rendering Blender with Mesa software OpenGL (llvmpipe)"
  export LIBGL_ALWAYS_SOFTWARE=1
  export GALLIUM_DRIVER=llvmpipe
  blender
fi

# Keep the desktop alive if Blender is closed so the user can relaunch from the menu
sleep infinity
