Bootstrap: docker
From: ubuntu:22.04

# Apptainer image bundling TurboVNC + XFCE + Blender for the Open OnDemand `vnc`
# app on ERIS/nucleus (CPU nodes -> software OpenGL via Mesa llvmpipe). Build:
#   module load Apptainer/1.4.2-1.el9
#   export APPTAINER_CACHEDIR=/data/vazquez/users/$USER/.apptainer/cache
#   apptainer build blender.sif blender.def
# Then place blender.sif at /data/vazquez/ondemand/images/blender/blender.sif.

%labels
    Maintainer Vazquez-Garcia Lab
    App Blender desktop for Open OnDemand (VNC, software OpenGL)

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # Desktop + X + VNC runtime deps (perl/xfonts/xkb required by TurboVNC's vncserver)
    apt-get install -y --no-install-recommends \
        ca-certificates wget xz-utils \
        perl xauth xkb-data x11-xkb-utils xfonts-base \
        dbus-x11 x11-xserver-utils xterm \
        xfce4 xfce4-session xfwm4 xfce4-panel xfce4-settings xfconf xfce4-terminal \
        libgtk-3-0 libgtk-3-bin libgdk-pixbuf2.0-bin \
        hicolor-icon-theme adwaita-icon-theme librsvg2-common \
        libgl1-mesa-glx libgl1-mesa-dri libglu1-mesa libegl1 \
        libxi6 libxxf86vm1 libxfixes3 libxrender1 libxrandr2 libxinerama1 libxcursor1 \
        libxkbcommon0 libsm6 libice6 libgomp1 fonts-dejavu \
        python3 python3-pip

    # websockify — the OnDemand `vnc` template proxies the VNC session through it
    pip3 install --no-cache-dir websockify

    # TurboVNC — provides the vncserver/Xvnc the OOD vnc template launches
    TVNC_VER=3.1.2
    wget -O /tmp/turbovnc.deb \
        https://github.com/TurboVNC/turbovnc/releases/download/${TVNC_VER}/turbovnc_${TVNC_VER}_amd64.deb
    apt-get install -y /tmp/turbovnc.deb
    rm -f /tmp/turbovnc.deb

    # VirtualGL — for GPU nodes (hardware-accelerated GL via `vglrun`). Harmless on
    # CPU nodes, where the launcher falls back to Mesa software GL. Bundled now so
    # the image is GPU-ready once GPU partitions arrive (no rebuild needed).
    VGL_VER=3.1.2
    wget -O /tmp/virtualgl.deb \
        https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VER}/virtualgl_${VGL_VER}_amd64.deb
    apt-get install -y /tmp/virtualgl.deb
    rm -f /tmp/virtualgl.deb

    # Blender (portable tarball ships its own Python + libs)
    BL=blender-4.2.23-linux-x64
    wget -O /tmp/blender.tar.xz \
        https://download.blender.org/release/Blender4.2/${BL}.tar.xz
    tar -xJf /tmp/blender.tar.xz -C /opt
    rm -f /tmp/blender.tar.xz
    ln -s /opt/${BL}/blender /usr/local/bin/blender

    # Regenerate the gdk-pixbuf loader cache and GTK icon caches. The dpkg triggers
    # that normally do this don't run reliably during an Apptainer build, leaving an
    # empty loaders.cache -> gdk-pixbuf can't decode PNG -> xfce4-panel fatally bails
    # ("Unrecognized image file format" loading image-missing.png). Do it explicitly.
    /usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders --update-cache
    update-mime-database /usr/share/mime || true
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    gtk-update-icon-cache -f -t /usr/share/icons/Adwaita 2>/dev/null || true

    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/TurboVNC/bin:$PATH
    # NOTE: software-GL env vars are set by the launcher only on the CPU path, so
    # they don't defeat VirtualGL on GPU nodes.

%test
    /opt/TurboVNC/bin/vncserver --help 2>&1 | head -1 || true
    test -x /usr/local/bin/blender && echo "blender present"
