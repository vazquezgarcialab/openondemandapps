<%-
  cores = num_cores.to_i
  mem   = memory.to_i
  hours = num_hours.to_i
  # GPUs live only on the gpu-* partitions, and those are reserved for GPU jobs
  # (partition QOS `gpu_required`) — so force at least one GPU there and none
  # elsewhere, whichever way the form's dynamic JS left the field.
  gpus  = queue.to_s.start_with?("gpu") ? [num_gpus.to_i, 1].max : 0
  # gpu-l40s caps wall time at 8 h; clamp so the job is accepted rather than
  # rejected at submit. Raise this if MGB raises the partition's MaxTime.
  hours = [hours, 8].min if gpus > 0
-%>
---
batch_connect:
  # OOD's VNC template: starts TurboVNC + websockify/noVNC, then runs the
  # generated session script (the "%s" below) inside our container. TurboVNC and
  # websockify live in the image, so the whole VNC session runs inside it.
  template: vnc
  script_wrapper: |
    set -x
    module load Apptainer/1.4.2-1.el9 2>/dev/null || module load singularity/latest 2>/dev/null || true
    CONTAINER_CMD="$(command -v apptainer || command -v singularity)"
    # $HOME (/PHShome/<user>) is a symlink into /PHShome_actual — bind both.
    export APPTAINER_BINDPATH="/data,/PHShome,/PHShome_actual"
    export SINGULARITY_BINDPATH="${APPTAINER_BINDPATH}"
    cat << "EOF" > container.sh
    export PATH="$PATH:/opt/TurboVNC/bin"
    export WEBSOCKIFY_CMD=/usr/local/bin/websockify
    %s
    EOF
    chmod u+x container.sh
    # Expose the host NVIDIA driver + userspace libraries inside the container
    # when the job actually has a GPU (`--nv`); on CPU nodes the flag list stays
    # empty. SLURM sets CUDA_VISIBLE_DEVICES for --gpus jobs.
    NV_OPT=()
    if [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && command -v nvidia-smi >/dev/null 2>&1; then
      NV_OPT=(--nv)
    fi

    "${CONTAINER_CMD}" exec "${NV_OPT[@]}" "<%= blender_image %>" /bin/bash "$(readlink -f container.sh)"
script:
  native:
    - "--partition"
    - "<%= queue %>"
    - "--nodes"
    - "1"
    - "--ntasks"
    - "<%= cores %>"
    - "--mem"
    - "<%= mem %>G"
    - "--time"
    - "<%= hours %>:00:00"
    <%- if gpus > 0 -%>
    - "--gpus"
    - "<%= gpus %>"
    <%- end -%>
