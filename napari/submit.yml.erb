<%-
  cores = num_cores.to_i
  mem   = memory.to_i
  hours = num_hours.to_i
  # GPU partitions and their limits, from `scontrol -a show partition`. Both are
  # reserved for GPU jobs (QOS `gpu_required`), so a listed partition always gets
  # at least one GPU, capped at the per-node count, and wall time clamped to its
  # MaxTime; any other partition never gets --gpus. This holds whatever the
  # form's dynamic JS left in the fields. Update the table when MGB changes a
  # partition (or renames devel-gpu).
  gpu_partitions = {
    "gpu-l40s"  => { max_gpus: 2, max_hours: 8 },    # 2x L40S per node, open to all
    "devel-gpu" => { max_gpus: 8, max_hours: 336 },  # 8x H200 per node, by request
  }
  part  = gpu_partitions[queue.to_s]
  gpus  = part ? num_gpus.to_i.clamp(1, part[:max_gpus]) : 0
  hours = [hours, part[:max_hours]].min if part
-%>
---
batch_connect:
  # OOD's VNC template: starts TurboVNC + websockify/noVNC, then runs the
  # generated session script (the "%s" below) inside our container.
  template: vnc
  script_wrapper: |
    set -x
    # Apptainer/Singularity is a module on ERIS Nucleus (not on the base PATH)
    module load Apptainer/1.4.2-1.el9 2>/dev/null || module load singularity/latest 2>/dev/null || true
    CONTAINER_CMD="$(command -v apptainer || command -v singularity)"

    # Bind data/home filesystems. napari is a viewer (no SLURM submission from
    # inside), so no munge/slurm binds needed.
    # $HOME (/PHShome/<user>) is a symlink into /PHShome_actual — bind both so it resolves in the container
    export APPTAINER_BINDPATH="/data,/PHShome,/PHShome_actual"
    export SINGULARITY_BINDPATH="${APPTAINER_BINDPATH}"

    cat << "EOF" > container.sh
    # TurboVNC binaries live under /opt/TurboVNC/bin inside the image
    export PATH="$PATH:/opt/TurboVNC/bin"
    # websockify is pip-installed at /usr/local/bin here (OOD's default is /opt/websockify/run)
    export WEBSOCKIFY_CMD=/usr/local/bin/websockify
    %s
    EOF
    chmod u+x container.sh

    # Expose the host NVIDIA driver + userspace libraries inside the container
    # when the job actually has a GPU (`--nv`); on CPU nodes the flag list stays
    # empty. SLURM sets CUDA_VISIBLE_DEVICES for --gpus jobs.
    NV_OPT=()
    if [ -n "${CUDA_VISIBLE_DEVICES:-}" ] && command -v nvidia-smi >/dev/null 2>&1; then
      NV_OPT=(--nv)
    fi

    "${CONTAINER_CMD}" exec "${NV_OPT[@]}" "<%= napari_image %>" /bin/bash "$(readlink -f container.sh)"

script:
  native:
    - "--partition"
    - "<%= queue %>"
    - "--nodes"
    - "1"
    - "--ntasks"
    - "<%= cores %>"
    - "--mem"
    - "<%= mem %>G"
    - "--time"
    - "<%= hours %>:00:00"
    <%- if gpus > 0 -%>
    - "--gpus"
    - "<%= gpus %>"
    <%- end -%>
