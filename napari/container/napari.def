Bootstrap: docker
From: ubuntu:22.04

# Apptainer image bundling TurboVNC + XFCE (window manager only) + napari for the
# Open OnDemand `vnc` app on ERIS/nucleus. napari is a Qt app rendering via
# OpenGL -> software Mesa (llvmpipe) on CPU nodes, VirtualGL (`vglrun`) on GPU
# nodes. Bundles cellpose for deep-learning segmentation. Build:
#   module load Apptainer/1.4.2-1.el9
#   export APPTAINER_CACHEDIR=/data/vazquez/users/$USER/.apptainer/cache
#   apptainer build napari.sif napari.def
# Then place napari.sif at /data/vazquez/ondemand/images/napari/napari.sif.

%labels
    Maintainer Vazquez-Garcia Lab
    App napari image viewer desktop for Open OnDemand (VNC, software OpenGL)

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # Desktop + X + VNC runtime deps (perl/xfonts/xkb required by TurboVNC's vncserver).
    # We run only the xfwm4 window manager (no xfce4-panel), so GTK is just for xfwm4.
    apt-get install -y --no-install-recommends \
        ca-certificates wget curl xz-utils unzip \
        perl xauth xkb-data x11-xkb-utils xfonts-base \
        dbus-x11 x11-xserver-utils xterm \
        xfce4-session xfwm4 xfconf \
        libgtk-3-0 \
        libgl1-mesa-glx libgl1-mesa-dri libglu1-mesa libegl1 libopengl0 \
        libglib2.0-0 libfontconfig1 libsm6 libice6 libxi6 libxrender1 libxext6 \
        libxrandr2 libxfixes3 libxcursor1 libxinerama1 libxtst6 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xfixes0 \
        libxcb-util1 libxcb-cursor0 libxkbcommon-x11-0 libdbus-1-3 \
        fonts-dejavu \
        python3 python3-pip python3-dev

    # websockify — the OnDemand `vnc` template proxies the VNC session through it
    pip3 install --no-cache-dir websockify

    # TurboVNC — provides the vncserver/Xvnc the OOD vnc template launches
    TVNC_VER=3.1.2
    wget -O /tmp/turbovnc.deb \
        https://github.com/TurboVNC/turbovnc/releases/download/${TVNC_VER}/turbovnc_${TVNC_VER}_amd64.deb
    apt-get install -y /tmp/turbovnc.deb
    rm -f /tmp/turbovnc.deb

    # VirtualGL — for GPU nodes (hardware-accelerated GL via `vglrun`). Harmless on
    # CPU nodes, where the launcher falls back to Mesa software GL. Bundled now so
    # the image is GPU-ready once GPU partitions arrive.
    VGL_VER=3.1.2
    wget -O /tmp/virtualgl.deb \
        https://github.com/VirtualGL/virtualgl/releases/download/${VGL_VER}/virtualgl_${VGL_VER}_amd64.deb
    apt-get install -y /tmp/virtualgl.deb
    rm -f /tmp/virtualgl.deb

    pip3 install --no-cache-dir --upgrade pip

    # PyTorch (CPU build for now — GPU nodes aren't available yet). When GPU
    # partitions arrive, rebuild swapping this for the CUDA wheel so cellpose can
    # use the GPU (the launcher already runs napari under vglrun on GPU nodes).
    pip3 install --no-cache-dir torch torchvision \
        --index-url https://download.pytorch.org/whl/cpu

    # napari (full: Qt backend + built-in plugins) and cellpose (segmentation).
    pip3 install --no-cache-dir "napari[all]" cellpose

    apt-get clean && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/TurboVNC/bin:$PATH
    # napari is Qt/X11 under Xvnc; pin the platform so it doesn't probe Wayland.
    export QT_QPA_PLATFORM=xcb
    # NOTE: software-GL env vars are set by the launcher only on the CPU path, so
    # they don't defeat VirtualGL on GPU nodes.

%test
    /opt/TurboVNC/bin/vncserver --help 2>&1 | head -1 || true
    python3 -c "import napari; print('napari', napari.__version__)"
    python3 -c "import cellpose; print('cellpose', cellpose.version)" || true
