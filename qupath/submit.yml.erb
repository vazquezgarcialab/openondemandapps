<%-
  cores = num_cores.to_i
  mem   = memory.to_i
  hours = num_hours.to_i
-%>
---
batch_connect:
  # OOD runs the entire VNC session (Xvnc + websockify + our before/script/after)
  # INSIDE this Apptainer image via its native container support. TurboVNC is on
  # PATH from the image's %environment; websockify is pip-installed at the path below.
  template: "vnc"
  container_path: "<%= qupath_image %>"
  container_command: "apptainer"
  container_module: "Apptainer/1.4.2-1.el9"
  # $HOME (/PHShome/<user>) is a symlink into /PHShome_actual, so bind both.
  # No SLURM/munge binds needed — a viewer doesn't submit jobs.
  container_bindpath: "/data,/PHShome,/PHShome_actual"
  websockify_cmd: "/usr/local/bin/websockify"
script:
  native:
    - "--partition"
    - "<%= queue %>"
    - "--nodes"
    - "1"
    - "--ntasks"
    - "<%= cores %>"
    - "--mem"
    - "<%= mem %>G"
    - "--time"
    - "<%= hours %>:00:00"
