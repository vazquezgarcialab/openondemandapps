#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

cd "${HOME}"
export PYTHONNOUSERSITE=1

# Expand the binary path (handle leading ~)
MLFLOW_BIN="<%= context.mlflow_binary %>"
MLFLOW_BIN="${MLFLOW_BIN/#\~/$HOME}"

# Expand and ensure the tracking directory exists
MLFLOW_DIR="<%= context.mlflow_dir %>"
MLFLOW_DIR="${MLFLOW_DIR/#\~/$HOME}"
mkdir -p "${MLFLOW_DIR}"

echo "TIMING - Starting mlflow server at: $(date)"

# MLflow 3.x puts the filesystem tracking backend in "maintenance mode" and
# refuses to start on a file store unless this is set. The common use here is
# viewing an existing file-based ./mlruns, so opt in. (Point MLFLOW_DIR at a
# sqlite:// URI instead for the model registry / newest features.)
export MLFLOW_ALLOW_FILE_STORE=true

# Serve under the OnDemand /node reverse-proxy prefix so the UI's asset and API
# URLs resolve (the /node proxy does not strip the prefix) — MLflow's own
# --static-prefix handles this, analogous to TensorBoard's --path_prefix. Bind all
# interfaces so the proxy on the OnDemand host can reach this compute node. If the
# tracking directory looks like a URI (e.g. sqlite:///...), pass it through as-is;
# otherwise treat it as a local directory (file store).
case "${MLFLOW_DIR}" in
  *://*) STORE_URI="${MLFLOW_DIR}" ;;
  *)     STORE_URI="file:${MLFLOW_DIR}" ;;
esac
# MLflow 3.x validates the Host header (DNS-rebinding protection) and rejects
# requests arriving through the OnDemand /node proxy (whose Host is the portal
# domain, not the compute node) with "Invalid Host header". Access here is already
# gated by the OnDemand login + reverse proxy, so allow all hosts.
set -x
exec "${MLFLOW_BIN}" server \
  --host 0.0.0.0 \
  --port "${port}" \
  --backend-store-uri "${STORE_URI}" \
  --static-prefix "/node/${host}/${port}" \
  --allowed-hosts "*"
